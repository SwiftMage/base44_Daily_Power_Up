import React, { useState, useCallback, useRef } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { Download, Sparkles, Star, Heart, BookOpen, MessageCircle } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Link } from "react-router-dom";
import { createPageUrl } from "../../utils";

const anchorLinks = [
  { label: "Benefits", id: "benefits", icon: Sparkles, color: "text-yellow-600" },
  { label: "Reviews", id: "reviews", icon: Star, color: "text-pink-600" },
  { label: "Our Story", id: "story", icon: Heart, color: "text-red-500" },
  { label: "Community", id: "faq", icon: MessageCircle, color: "text-purple-600" },
  { label: "Blog", href: "blog", icon: BookOpen, color: "text-blue-600" },
];

function scrollToSection(id) {
  const el = document.getElementById(id);
  if (el) {
    el.scrollIntoView({ behavior: "smooth", block: "start" });
  }
}

const sparkleColors = ["#facc15", "#f472b6", "#a78bfa", "#60a5fa", "#fb923c"];

export default function Hero() {
  const [sparkles, setSparkles] = useState([]);
  const lastSparkle = useRef(0);

  const handleMouseMove = useCallback((e) => {
    const now = Date.now();
    if (now - lastSparkle.current < 50) return; // throttle to every 50ms
    lastSparkle.current = now;

    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const id = now + Math.random();
    const color = sparkleColors[Math.floor(Math.random() * sparkleColors.length)];
    const size = Math.random() * 10 + 6;

    setSparkles((prev) => [...prev.slice(-20), { id, x, y, color, size }]);
    setTimeout(() => {
      setSparkles((prev) => prev.filter((s) => s.id !== id));
    }, 600);
  }, []);

  return (
    <section
      className="relative overflow-hidden bg-gradient-to-br from-blue-100 via-purple-100 to-pink-100 pt-0"
      onMouseMove={handleMouseMove}
    >
      {/* Sparkle cursor trail */}
      <AnimatePresence>
        {sparkles.map((s) => (
          <motion.svg
            key={s.id}
            className="absolute pointer-events-none z-50"
            style={{ left: s.x - s.size / 2, top: s.y - s.size / 2 }}
            width={s.size}
            height={s.size}
            viewBox="0 0 24 24"
            fill={s.color}
            initial={{ opacity: 1, scale: 1, y: 0 }}
            animate={{ opacity: 0, scale: 0.3, y: -20 }}
            exit={{ opacity: 0 }}
            transition={{ duration: 0.6, ease: "easeOut" }}
          >
            <path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.4l-6.18 3.62L7 12.14 2 7.27l6.91-1.01L12 0z" />
          </motion.svg>
        ))}
      </AnimatePresence>
      {/* Decorative background elements */}
      <div className="absolute top-10 left-10 w-72 h-72 bg-yellow-300 rounded-full opacity-30 blur-3xl animate-pulse" />
      <div className="absolute top-20 right-10 w-96 h-96 bg-blue-300 rounded-full opacity-30 blur-3xl animate-pulse" style={{ animationDelay: '1s' }} />
      <div className="absolute bottom-10 left-1/3 w-80 h-80 bg-purple-300 rounded-full opacity-30 blur-3xl animate-pulse" style={{ animationDelay: '2s' }} />
      <div className="absolute bottom-20 right-1/4 w-64 h-64 bg-pink-300 rounded-full opacity-30 blur-3xl animate-pulse" style={{ animationDelay: '1.5s' }} />

      {/* Top row: anchor links */}
      <div className="relative z-10 flex items-center justify-end px-4 md:px-6 pt-2 max-w-7xl mx-auto">
        <div className="flex flex-wrap items-center justify-end gap-2 md:gap-3 pt-2">
          {anchorLinks.map((link) => {
            const Icon = link.icon;
            const inner = (
              <span className="flex items-center gap-1.5 group">
                <Icon className={`w-4 h-4 ${link.color} transition-transform group-hover:scale-125`} />
                <span>{link.label}</span>
              </span>
            );
            return link.href ? (
              <Link
                key={link.label}
                to={createPageUrl(link.href)}
                className="text-sm md:text-base font-semibold px-3 py-1.5 rounded-xl transition-all duration-200 text-gray-700 hover:bg-white/50 hover:text-gray-900"
              >
                {inner}
              </Link>
            ) : (
              <button
                key={link.label}
                onClick={() => scrollToSection(link.id)}
                className="text-sm md:text-base font-semibold px-3 py-1.5 rounded-xl transition-all duration-200 text-gray-700 hover:bg-white/50 hover:text-gray-900"
              >
                {inner}
              </button>
            );
          })}
        </div>
      </div>

      <div className="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-14 pt-2 pb-6 md:pt-2 md:pb-10 w-full">
        {/* Row 1: Logo + Headline spanning full width */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="flex items-center gap-4 md:gap-6 mb-6 md:mb-8"
        >
          <motion.img
            src="/images/logo.png"
            alt="Daily Power Up!"
            className="h-32 md:h-44 lg:h-52 w-auto drop-shadow-lg flex-shrink-0"
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: [0, -6, 0] }}
            transition={{ delay: 0.2, duration: 0.5, y: { delay: 1, duration: 2, repeat: Infinity, repeatType: "reverse", ease: "easeInOut" } }}
          />
          <div className="relative">
            <h1 className="text-xl md:text-3xl lg:text-4xl font-extrabold leading-tight" style={{ color: 'rgb(65, 129, 197)' }}>
              The self-talk app for kids that turns big struggles into strengths!
            </h1>
            {/* Floating sparkle accents */}
            <motion.div
              className="absolute -top-3 -right-2 md:-top-4 md:-right-4"
              animate={{ rotate: [0, 15, -15, 0], scale: [1, 1.2, 1] }}
              transition={{ duration: 3, repeat: Infinity, ease: "easeInOut" }}
            >
              <Sparkles className="w-5 h-5 md:w-7 md:h-7 text-yellow-400" />
            </motion.div>
            <motion.div
              className="absolute -bottom-6 left-8 md:-bottom-8 md:left-12"
              animate={{ rotate: [0, -10, 10, 0], scale: [1, 1.15, 1] }}
              transition={{ duration: 4, repeat: Infinity, ease: "easeInOut", delay: 1 }}
            >
              <Star className="w-4 h-4 md:w-5 md:h-5 text-pink-400 fill-pink-300" />
            </motion.div>
          </div>
        </motion.div>

        {/* Row 2: Two columns - Benefits box on left, Hero image + buttons on right */}
        <div className="grid md:grid-cols-2 gap-8 md:gap-12 items-stretch">
          {/* Left side - Benefits box */}
          <motion.div
            initial={{ opacity: 0, x: -30 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.3, duration: 0.6 }}
            className="flex"
          >
            <div className="flex flex-col justify-center w-full p-4 md:p-6">
              <p className="text-lg md:text-xl font-bold mb-6 text-center" style={{ color: 'rgb(65, 129, 197)' }}>
                Neuroscience-backed self-talk to help your child:
              </p>
              {/* Freestanding animated benefits */}
              <div className="flex flex-col gap-4 md:gap-5">
                {[
                  { text: "Fewer Meltdowns", color: "#2EAD4B", icon: Heart, bobDelay: 0, bobDuration: 2.5 },
                  { text: "More Cooperation", color: "#F5852A", icon: Star, bobDelay: 0.4, bobDuration: 3 },
                  { text: "Less Anxiety", color: "#3BADD6", icon: Sparkles, bobDelay: 0.8, bobDuration: 2.8 },
                  { text: "Real Self-Esteem", color: "#F5D033", icon: Star, bobDelay: 1.2, bobDuration: 3.2 },
                  { text: "Joy, Calm & Courage", color: "#E84D8A", icon: Sparkles, bobDelay: 1.6, bobDuration: 2.6 },
                ].map((b, i) => {
                  const Icon = b.icon;
                  return (
                    <motion.div
                      key={i}
                      initial={{ opacity: 0, x: -30, scale: 0.8 }}
                      animate={{
                        opacity: 1,
                        x: 0,
                        scale: 1,
                        y: [0, -3, 0],
                      }}
                      transition={{
                        opacity: { delay: 0.4 + i * 0.15, duration: 0.5 },
                        x: { delay: 0.4 + i * 0.15, duration: 0.5 },
                        scale: { delay: 0.4 + i * 0.15, duration: 0.5 },
                        y: { delay: b.bobDelay + 1, duration: b.bobDuration, repeat: Infinity, repeatType: "reverse", ease: "easeInOut" },
                      }}
                      className="flex items-center gap-3"
                    >
                      <motion.div
                        animate={{ rotate: [0, 10, -10, 0] }}
                        transition={{ duration: 3, repeat: Infinity, ease: "easeInOut", delay: b.bobDelay }}
                      >
                        <Icon className="w-6 h-6 md:w-7 md:h-7 flex-shrink-0" style={{ color: b.color, fill: b.color, opacity: 0.7 }} />
                      </motion.div>
                      <span className="text-xl md:text-2xl font-extrabold tracking-tight" style={{ color: b.color }}>{b.text}</span>
                    </motion.div>
                  );
                })}
              </div>
            </div>
          </motion.div>

          {/* Right side - Hero child image + buttons underneath */}
          <motion.div
            initial={{ opacity: 0, x: 30 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.4, duration: 0.6 }}
            className="flex flex-col"
          >
            <div className="relative flex-1">
              <img
                src="/images/hero-child.png"
                alt="Happy child with positive affirmations"
                className="w-full h-full object-cover rounded-3xl shadow-2xl"
              />
              {/* Floating decorative elements around image */}
              <motion.div
                className="absolute -top-3 -left-3 md:-top-4 md:-left-4"
                animate={{ y: [0, -8, 0], rotate: [0, 10, 0] }}
                transition={{ duration: 3, repeat: Infinity, ease: "easeInOut" }}
              >
                <Heart className="w-6 h-6 md:w-8 md:h-8 text-red-400 fill-red-300 drop-shadow-md" />
              </motion.div>
              <motion.div
                className="absolute -bottom-2 -right-2 md:-bottom-3 md:-right-3"
                animate={{ y: [0, -6, 0], rotate: [0, -15, 0] }}
                transition={{ duration: 3.5, repeat: Infinity, ease: "easeInOut", delay: 0.5 }}
              >
                <Sparkles className="w-6 h-6 md:w-8 md:h-8 text-yellow-400 drop-shadow-md" />
              </motion.div>
              <motion.div
                className="absolute top-1/2 -right-4 md:-right-6"
                animate={{ scale: [1, 1.3, 1], opacity: [0.7, 1, 0.7] }}
                transition={{ duration: 2.5, repeat: Infinity, ease: "easeInOut", delay: 1.5 }}
              >
                <Star className="w-5 h-5 md:w-6 md:h-6 text-purple-400 fill-purple-300 drop-shadow-md" />
              </motion.div>
            </div>

            {/* CTA Row: App Store Badge + Start Free Trial - straight row underneath image */}
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.6, duration: 0.6 }}
              className="flex items-center justify-center gap-4 mt-6"
            >
              <a
                href="https://apps.apple.com/us/app/daily-affirmations-power-up/id6744414135"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-block transition-transform duration-300 hover:scale-105 flex-shrink-0"
              >
                <img
                  src="/images/download-badge-new.png"
                  alt="Download on the App Store"
                  className="h-12 md:h-14 w-auto"
                  style={{ filter: 'drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1))' }}
                />
              </a>
              <Button
                size="lg"
                className="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-6 md:px-10 py-5 md:py-7 text-base md:text-xl lg:text-2xl rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:scale-105 font-bold flex-shrink-0"
                onClick={() => window.open("https://apps.apple.com/us/app/daily-affirmations-power-up/id6744414135", "_blank")}
              >
                <Download className="w-5 md:w-6 h-5 md:h-6 mr-2 md:mr-3 flex-shrink-0" />
                Start Free Trial
              </Button>
            </motion.div>
          </motion.div>
        </div>
      </div>
    </section>
  );
}
