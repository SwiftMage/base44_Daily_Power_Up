// All variations array
const variations = [
  { component: Variation1, name: "Centered Minimal", inspiration: "Apple" },
  { component: Variation2, name: "Split Screen Gradient", inspiration: "Headspace" },
  { component: Variation3, name: "Dark Mode Elegant", inspiration: "Calm" },
  { component: Variation4, name: "Bold Typography", inspiration: "Notion" },
  { component: Variation5, name: "Playful Colorful", inspiration: "Duolingo" },
  { component: Variation6, name: "Magazine Editorial", inspiration: "Medium" },
  { component: Variation7, name: "Vertical Stack", inspiration: "Spotify" },
  { component: Variation8, name: "Side-by-Side Equal", inspiration: "Slack" },
  { component: Variation9, name: "Soft Pastel", inspiration: "Figma" },
  { component: Variation10, name: "Bold Contrast", inspiration: "Stripe" },
  { component: Variation11, name: "Geometric Fun", inspiration: "Mailchimp" },
  { component: Variation12, name: "Minimalist", inspiration: "Muji" },
  { component: Variation13, name: "Gradient Mesh", inspiration: "Linear" },
  { component: Variation14, name: "Trustworthy Pro", inspiration: "Intercom" },
  { component: Variation15, name: "Playful Illustrated", inspiration: "Miro" },
  { component: Variation16, name: "Cards Focus", inspiration: "Trello" },
  { component: Variation17, name: "Hero Video Style", inspiration: "Netflix" },
  { component: Variation18, name: "Pricing Forward", inspiration: "Webflow" },
  { component: Variation19, name: "Testimonial Focus", inspiration: "Airbnb" },
  { component: Variation20, name: "Fun & Bold", inspiration: "Discord" },
];

export default function Hero() {
  const [currentVariation, setCurrentVariation] = useState(0);

  const goNext = () => setCurrentVariation((prev) => (prev + 1) % variations.length);
  const goPrev = () => setCurrentVariation((prev) => (prev - 1 + variations.length) % variations.length);

  const CurrentComponent = variations[currentVariation].component;

  return (
    <div className="relative">
      {/* Navigation Controls */}
      <div className="fixed top-1/2 -translate-y-1/2 left-4 z-50">
        <button
          onClick={goPrev}
          className="bg-white/90 hover:bg-white shadow-lg rounded-full p-3 transition-all hover:scale-110"
        >
          <ChevronLeft className="w-6 h-6 text-gray-700" />
        </button>
      </div>
      <div className="fixed top-1/2 -translate-y-1/2 right-4 z-50">
        <button
          onClick={goNext}
          className="bg-white/90 hover:bg-white shadow-lg rounded-full p-3 transition-all hover:scale-110"
        >
          <ChevronRight className="w-6 h-6 text-gray-700" />
        </button>
      </div>

      {/* Variation Info */}
      <div className="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-white/95 backdrop-blur shadow-xl rounded-2xl px-6 py-3 flex items-center gap-6">
        <div className="text-center">
          <p className="text-sm text-gray-500">Variation</p>
          <p className="font-bold text-lg">{currentVariation + 1} / {variations.length}</p>
        </div>
        <div className="h-10 w-px bg-gray-200" />
        <div>
          <p className="font-semibold text-gray-900">{variations[currentVariation].name}</p>
          <p className="text-sm text-gray-500">Inspired by {variations[currentVariation].inspiration}</p>
        </div>
        <div className="h-10 w-px bg-gray-200" />
        <div className="flex gap-1">
          {variations.map((_, i) => (
            <button
              key={i}
              onClick={() => setCurrentVariation(i)}
              className={`w-2.5 h-2.5 rounded-full transition-all ${
                i === currentVariation ? "bg-blue-600 scale-125" : "bg-gray-300 hover:bg-gray-400"
              }`}
            />
          ))}
        </div>
      </div>

      {/* Current Variation */}
      <AnimatePresence mode="wait">
        <motion.div
          key={currentVariation}
          initial={{ opacity: 0, x: 50 }}
          animate={{ opacity: 1, x: 0 }}
          exit={{ opacity: 0, x: -50 }}
          transition={{ duration: 0.3 }}
        >
          <CurrentComponent />
        </motion.div>
      </AnimatePresence>
    </div>
  );
}
