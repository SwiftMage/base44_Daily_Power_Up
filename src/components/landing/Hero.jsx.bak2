import React, { useState, useCallback, useRef } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { CheckSquare, Sparkles, Star, Heart, BookOpen, MessageCircle, Download } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Link } from "react-router-dom";
import { createPageUrl } from "../../utils";

const anchorLinks = [
  { label: "Benefits", id: "benefits", icon: Sparkles, color: "text-yellow-600" },
  { label: "Reviews", id: "reviews", icon: Star, color: "text-pink-600" },
  { label: "Our Story", id: "story", icon: Heart, color: "text-red-500" },
  { label: "Community", id: "faq", icon: MessageCircle, color: "text-purple-600" },
  { label: "Blog", href: "blog", icon: BookOpen, color: "text-blue-600" },
];

function scrollToSection(id) {
  const el = document.getElementById(id);
  if (el) {
    el.scrollIntoView({ behavior: "smooth", block: "start" });
  }
}

const sparkleColors = ["#facc15", "#f472b6", "#a78bfa", "#60a5fa", "#fb923c"];

const checklistItems = [
  "Fewer Meltdowns",
  "More Cooperation",
  "Less Anxiety",
  "Real Self-Esteem",
  "Joy, Calm & Courage",
];

// Hand-drawn crayon stars - pushed below nav area (top starts at 18%+)
const doodleStars = [
  { top: "18%", left: "3%", size: 44, rotate: 15, delay: 0 },
  { top: "22%", left: "92%", size: 50, rotate: -12, delay: 0.3 },
  { top: "45%", left: "1%", size: 38, rotate: 25, delay: 0.6 },
  { top: "55%", left: "95%", size: 42, rotate: -20, delay: 0.9 },
  { top: "75%", left: "4%", size: 36, rotate: 10, delay: 1.2 },
  { top: "80%", left: "90%", size: 46, rotate: -8, delay: 0.4 },
  { top: "35%", left: "96%", size: 32, rotate: 30, delay: 0.7 },
  { top: "65%", left: "2%", size: 40, rotate: -15, delay: 1.0 },
];

// Hand-drawn crayon star SVG path (wobbly, organic)
const crayonStarPath = "M12 1.5c.4 1.2 1.1 3.2 2.2 4.8.7.9 1.8 1.6 3.5 2.1 1.2.4 2.6.6 3.8.8-1.1.8-2.3 1.6-3.1 2.7-.9 1.2-1.3 2.8-1.5 4.2-.2 1-.2 2.1-.3 3-.4-1.3-1-2.8-1.9-4-.8-1-2-1.8-3.3-2.4-1-.5-2.2-.8-3.4-1.2 1.3-.6 2.7-1.2 3.6-2.2 1-1.1 1.4-2.6 1.7-4 .2-.8.3-1.8.4-2.8z";

export default function Hero() {
  const [sparkles, setSparkles] = useState([]);
  const lastSparkle = useRef(0);

  const handleMouseMove = useCallback((e) => {
    const now = Date.now();
    if (now - lastSparkle.current < 50) return;
    lastSparkle.current = now;

    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const id = now + Math.random();
    const color = sparkleColors[Math.floor(Math.random() * sparkleColors.length)];
    const size = Math.random() * 10 + 6;

    setSparkles((prev) => [...prev.slice(-20), { id, x, y, color, size }]);
    setTimeout(() => {
      setSparkles((prev) => prev.filter((s) => s.id !== id));
    }, 600);
  }, []);

  return (
    <section
      className="relative overflow-hidden min-h-screen flex flex-col"
      style={{ backgroundColor: "#c8e6c0" }}
      onMouseMove={handleMouseMove}
    >
      {/* Sparkle cursor trail */}
      <AnimatePresence>
        {sparkles.map((s) => (
          <motion.svg
            key={s.id}
            className="absolute pointer-events-none z-50"
            style={{ left: s.x - s.size / 2, top: s.y - s.size / 2 }}
            width={s.size}
            height={s.size}
            viewBox="0 0 24 24"
            fill={s.color}
            initial={{ opacity: 1, scale: 1, y: 0 }}
            animate={{ opacity: 0, scale: 0.3, y: -20 }}
            exit={{ opacity: 0 }}
            transition={{ duration: 0.6, ease: "easeOut" }}
          >
            <path d="M12 0l3.09 6.26L22 7.27l-5 4.87 1.18 6.88L12 15.4l-6.18 3.62L7 12.14 2 7.27l6.91-1.01L12 0z" />
          </motion.svg>
        ))}
      </AnimatePresence>

      {/* Hand-drawn crayon star doodles - framing content, away from nav */}
      {doodleStars.map((star, i) => (
        <motion.svg
          key={i}
          className="absolute pointer-events-none z-0"
          style={{ top: star.top, left: star.left }}
          width={star.size}
          height={star.size}
          viewBox="0 0 24 24"
          initial={{ opacity: 0, rotate: star.rotate }}
          animate={{ opacity: [0.35, 0.6, 0.35], rotate: star.rotate }}
          transition={{ delay: star.delay, duration: 4, repeat: Infinity, ease: "easeInOut" }}
        >
          <path
            d={crayonStarPath}
            fill="#dbb444"
            stroke="#c9a030"
            strokeWidth="0.8"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        </motion.svg>
      ))}

      {/* Anchor links row */}
      <div className="relative z-10 flex items-center justify-end px-4 md:px-6 pt-3 max-w-5xl mx-auto w-full">
        <div className="flex flex-wrap items-center justify-end gap-2 md:gap-3">
          {anchorLinks.map((link) => {
            const Icon = link.icon;
            const inner = (
              <span className="flex items-center gap-1.5 group">
                <Icon className={`w-4 h-4 ${link.color} transition-transform group-hover:scale-125`} />
                <span>{link.label}</span>
              </span>
            );
            return link.href ? (
              <Link
                key={link.label}
                to={createPageUrl(link.href)}
                className="text-sm md:text-base font-semibold px-2.5 py-1 rounded-xl transition-all duration-200 text-gray-700 hover:bg-white/40 hover:text-gray-900"
              >
                {inner}
              </Link>
            ) : (
              <button
                key={link.label}
                onClick={() => scrollToSection(link.id)}
                className="text-sm md:text-base font-semibold px-2.5 py-1 rounded-xl transition-all duration-200 text-gray-700 hover:bg-white/40 hover:text-gray-900"
              >
                {inner}
              </button>
            );
          })}
        </div>
      </div>

      {/* Main content */}
      <div className="relative z-10 flex-1 flex flex-col max-w-5xl mx-auto px-6 md:px-10 py-6 md:py-10 w-full">

        {/* Logo + loopy arrow + tagline */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="flex items-center gap-3 md:gap-6 mb-8 md:mb-12"
        >
          <motion.img
            src="/images/logo.png"
            alt="Daily Power Up!"
            className="h-32 md:h-44 lg:h-52 w-auto drop-shadow-lg flex-shrink-0"
            initial={{ opacity: 0, scale: 0.8 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: 0.2, duration: 0.5 }}
          />
          {/* Loopy arrow + tagline */}
          <div className="flex flex-col items-start">
            <svg className="w-24 h-16 md:w-36 md:h-20 -mb-1" viewBox="0 0 140 70" fill="none">
              {/* Loopy playful arrow */}
              <path
                d="M8 55 C20 50, 25 20, 40 25 C55 30, 45 55, 60 45 C75 35, 65 15, 85 20 C105 25, 95 50, 115 35 C125 28, 128 22, 130 18"
                stroke="#333"
                strokeWidth="3"
                strokeLinecap="round"
                fill="none"
              />
              {/* Arrowhead */}
              <path d="M124 12 L132 18 L122 22" stroke="#333" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" fill="none" />
            </svg>
            <p className="text-2xl md:text-3xl lg:text-4xl italic font-bold text-gray-900 leading-snug">
              a self-talk app<br />made just for kids
            </p>
          </div>
        </motion.div>

        {/* Two column layout: checklist left, image + button right */}
        <div className="grid md:grid-cols-2 gap-8 md:gap-12 items-start flex-1">
          {/* Left: Checklist */}
          <motion.div
            initial={{ opacity: 0, x: -30 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.3, duration: 0.6 }}
            className="flex flex-col gap-5 md:gap-7 pt-2"
          >
            {checklistItems.map((item, i) => (
              <motion.div
                key={i}
                initial={{ opacity: 0, x: -30 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.5 + i * 0.15, duration: 0.5 }}
                className="flex items-center gap-4"
              >
                <CheckSquare className="w-9 h-9 md:w-11 md:h-11 flex-shrink-0" style={{ color: "#2d7a3a", strokeWidth: 2.5 }} />
                <span className="text-xl md:text-2xl lg:text-3xl font-semibold text-gray-900" style={{ fontFamily: "Georgia, serif" }}>
                  {item}
                </span>
              </motion.div>
            ))}
          </motion.div>

          {/* Right: Hero child image + download button */}
          <motion.div
            initial={{ opacity: 0, x: 30 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.4, duration: 0.6 }}
            className="flex flex-col items-center"
          >
            <img
              src="/images/hero-child.png"
              alt="Happy child with positive affirmations"
              className="w-full max-w-md rounded-3xl shadow-2xl mb-6"
            />

            {/* Download buttons */}
            <div className="flex items-center justify-center gap-4">
              <a
                href="https://apps.apple.com/us/app/daily-affirmations-power-up/id6744414135"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-block transition-transform duration-300 hover:scale-105 flex-shrink-0"
              >
                <img
                  src="/images/download-badge-new.png"
                  alt="Download on the App Store"
                  className="h-12 md:h-14 w-auto"
                  style={{ filter: 'drop-shadow(0 4px 6px rgba(0, 0, 0, 0.15))' }}
                />
              </a>
              <Button
                size="lg"
                className="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-6 md:px-8 py-5 md:py-6 text-base md:text-lg rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:scale-105 font-bold flex-shrink-0"
                onClick={() => window.open("https://apps.apple.com/us/app/daily-affirmations-power-up/id6744414135", "_blank")}
              >
                <Download className="w-5 h-5 mr-2 flex-shrink-0" />
                Start Free Trial
              </Button>
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  );
}
